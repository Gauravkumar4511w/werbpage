API_PORT=8787
DATABASE_DIR=./data
# Production database (turso.tech). Without these, data is a local file; on Vercel it is lost on restart.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_long_random_password
ADMIN_SESSION_SECRET=change_me_to_a_long_random_secret
VITE_UPI_ID=YOUR_UPI_ID@okaxis
VITE_UPI_NAME=ARENACORE

# Email codes for sign-up and "Forgot password". Without a provider, local dev shows the code on screen.
OTP_SECRET=change_me_to_a_long_random_secret
# Free through Gmail: turn on 2-Step Verification, then create an App Password
# at myaccount.google.com/apppasswords (about 500 emails a day).
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=
# Or Resend (resend.com), with a from address on a domain verified in Resend.
RESEND_API_KEY=
OTP_EMAIL_FROM=ArenaCore <no-reply@yourdomain.com>
# true shows the code on screen even when deployed (testing only); false never shows it.
OTP_DEV_MODE=

# "Sign in with Google": an OAuth client ID (type Web application) from console.cloud.google.com.
GOOGLE_CLIENT_ID=
