API_PORT=8787
DATABASE_DIR=./data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_long_random_password
ADMIN_SESSION_SECRET=change_me_to_a_long_random_secret
VITE_UPI_ID=YOUR_UPI_ID@okaxis
VITE_UPI_NAME=ARENACORE

# Sign-up OTP. Without a provider, local dev shows the code on screen instead of sending it.
OTP_SECRET=change_me_to_a_long_random_secret
# SMS: MSG91 (msg91.com), with the template ID of a DLT-approved OTP template using ##OTP##.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Or Fast2SMS for Indian numbers (fast2sms.com > Dev API), or Twilio for any country.
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email codes, free through Gmail: turn on 2-Step Verification, then create an App Password
# at myaccount.google.com/apppasswords (about 500 emails a day).
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=
# Or Resend (resend.com), with a from address on a domain verified in Resend.
RESEND_API_KEY=
OTP_EMAIL_FROM=ArenaCore <no-reply@yourdomain.com>
# true shows the code on screen even when deployed (testing only); false never shows it.
OTP_DEV_MODE=
